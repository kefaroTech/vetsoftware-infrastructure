# Copie este archivo a terraform.tfvars. Nunca guarde secretos aquí.
aws_region  = "us-east-1"
environment = "prod"

# Debe ser una etiqueta inmutable o, preferiblemente, un digest sha256.
backend_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/vetsoftware@sha256:REEMPLAZAR"

# Grafana Cloud > Connections > OpenTelemetry > OTLP endpoint.
grafana_otlp_endpoint = "https://otlp-gateway-prod-us-east-0.grafana.net/otlp"

cors_allowed_origins          = ["https://app.example.com"]
email_from                    = "VetSoftware <noreply@example.com>"
registration_verification_url = "https://app.example.com/verificar"
password_reset_url             = "https://app.example.com/restablecer"
login_url                      = "https://app.example.com/login"

# El certificado ACM se valida con un CNAME en Cloudflare y debe cubrir prod y dev.
api_domain_name = "api.kefaro.tech"
certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/REEMPLAZAR"

# Resuelva y mantenga los CIDR oficiales de los SaaS usados por el backend y Alloy.
# La ruta universal 0.0.0.0/0 esta prohibida por validacion y por el quality gate.
approved_external_https_ipv4_cidrs = [
  "203.0.113.10/32", # REEMPLAZAR: ejemplo documental, no desplegar.
]

# Variable ephemeral adicional, nunca tfvars:
# $env:TF_VAR_cloudflare_tunnel_token = "token-del-tunel-prod"

# Para comenzar más pequeño:
# backend_cpu                 = 512
# backend_memory              = 2048
# pdf_max_concurrent_renders  = 1
# pdf_max_pdf_size            = "15MB"
# database_instance_class     = "db.t4g.micro"
# database_max_allocated_storage = 50
# alloy_instance_type         = "t4g.micro"
# valkey_maximum_data_storage_gb  = 10
# valkey_maximum_ecpu_per_second  = 5000

alarm_email       = "infra@example.com"
monthly_budget_usd = 180
