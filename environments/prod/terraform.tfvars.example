# Copie este archivo a terraform.tfvars. Nunca guarde secretos aquí.
aws_region  = "us-east-1"
environment = "prod"

# Debe ser una etiqueta inmutable o, preferiblemente, un digest sha256.
backend_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/vetsoftware-backend@sha256:REEMPLAZAR_64_HEX"

# Grafana Cloud > Connections > OpenTelemetry > OTLP endpoint.
grafana_otlp_endpoint = "https://otlp-gateway-prod-us-east-0.grafana.net/otlp"

cors_allowed_origins          = ["https://app.example.com"]
email_from                    = "VetSoftware <noreply@example.com>"
# Pie de los correos y tope diario del asistente. Los tres enlaces conservan el
# destino que traia el backend por defecto; el tope se publica al contenedor.
# email_help_url              = "https://vetsoftware.co/ayuda"
# email_privacy_url           = "https://vetsoftware.co/privacidad"
# email_terms_url             = "https://vetsoftware.co/terminos"
# bedrock_daily_spend_cap_usd = 1.00
# Identificador con el que la aplicacion invoca al modelo, publicado como
# AI_PROPOSAL_MODEL_ID. Prod no instancia el modulo de Bedrock, asi que aqui no
# compone ninguna politica: solo la variable de entorno. Cambiar de familia es
# cambiar esta linea, con la misma regla que dev -perfil regional us.*-.
# bedrock_inference_profile_id = "us.anthropic.claude-haiku-4-5-20251001-v1:0"
registration_verification_url = "https://app.example.com/verificar"
password_reset_url             = "https://app.example.com/restablecer"
login_url                      = "https://app.example.com/login"
# Origen de la landing que recibe el ?token= del correo de la propuesta. Tiene default
# en variables.tf (https://app.vetsoftware.co, el dominio del front productivo segun
# docs/CLOUDFLARE_PAGES.md); descomente solo si el dominio cambia. Sin ruta y sin barra
# final: el backend concatena "/?token=<43 caracteres>".
# ai_proposal_link_base_url = "https://app.vetsoftware.co"

# Los cuatro UUID de plantilla de Resend del producto. Las plantillas se crean A MANO en
# el panel de Resend: copie aqui el identificador de cada una, nunca deje el marcador.
# Antes eran default commiteado en el application.yml del backend; ahora cada entorno
# apunta a las suyas sin recompilar la imagen.
registration_verification_template_id = "REEMPLAZAR_UUID_PLANTILLA_RESEND"
password_reset_template_id            = "REEMPLAZAR_UUID_PLANTILLA_RESEND"
employee_invitation_template_id       = "REEMPLAZAR_UUID_PLANTILLA_RESEND"
appointment_confirmation_template_id  = "REEMPLAZAR_UUID_PLANTILLA_RESEND"

# Cloudflare termina el TLS público; el origen local no requiere certificado ACM.
api_domain_name = "api.kefaro.tech"
# En Cloudflare Tunnel publique este host con origen http://localhost:8080.

# Variables ephemeral, NUNCA tfvars. Un secreto, una variable: el JSON que acaba en
# Secrets Manager lo compone modules/secrets. Los nombres de clave del secreto no
# cambian -los leen por sufijo las definiciones de tarea de ECS-.
# $env:TF_VAR_jwt_secret       = "REEMPLAZAR_MINIMO_32_CARACTERES"
# $env:TF_VAR_resend_api_key   = "re_REEMPLAZAR"
# $env:TF_VAR_recaptcha_secret = "REEMPLAZAR_SECRETO_DE_SERVIDOR_RECAPTCHA"
# DIAN_ENC_KEY es AES-256: exactamente 32 bytes codificados en base64.
# $env:TF_VAR_dian_enc_key = "REEMPLAZAR_32_BYTES_EN_BASE64"
#
# Alloy extrae del secreto OTLP_USERNAME y OTLP_API_KEY con jq. La cabecera ya
# construida se escribe igual porque el modulo es compartido con dev.
# $env:TF_VAR_otlp_username = "REEMPLAZAR_NUMERIC_INSTANCE_ID"
# $env:TF_VAR_otlp_api_key  = "glc_REEMPLAZAR"
# $basic = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("$env:TF_VAR_otlp_username:$env:TF_VAR_otlp_api_key"))
# $env:TF_VAR_otel_exporter_otlp_headers = "Authorization=Basic $basic"
#
# $env:TF_VAR_cloudflare_tunnel_token = "token-del-tunel-prod"

# Para comenzar más pequeño:
# backend_cpu                 = 512
# backend_memory              = 2048
# pdf_max_concurrent_renders  = 1
# pdf_max_pdf_size            = "15MB"
# database_instance_class     = "db.t4g.micro"
# database_max_allocated_storage = 50
# alloy_instance_type         = "t4g.micro"
# valkey_maximum_data_storage_gb  = 10
# valkey_maximum_ecpu_per_second  = 5000

# OBLIGATORIO: no tiene default. Sin destino no se crea el topic SNS y las
# alarmas se despliegan con alarm_actions vacio, sin fallar el plan ni el apply.
# La suscripcion llega por correo y hay que confirmarla a mano.
alarm_email        = "infra@example.com"
monthly_budget_usd = 180

# Opcional. Vacios dejan Slack apagado sin afectar al correo. Amazon Q Developer
# > Chat applications > Slack, para obtener los dos IDs.
# slack_workspace_id        = "T0123456789"
# slack_channel_id          = "C0123456789"
# slack_alerts_channel_id   = "C0ALERTAS00"
# slack_infra_channel_id    = "C0INFRA0000"
# slack_critical_channel_id = "C0CRITICO00"
# runbook_url               = "https://github.com/kefaroTech/vetsoftware-infrastructure/blob/main/docs/ALERTAS_OPERATIVAS.md"

# Requiere habilitar Cost Explorer a mano en la cuenta e importar el monitor de
# servicios que AWS crea al hacerlo. Ver la nota en variables.tf.
# cost_anomaly_detection_enabled = true
# cost_anomaly_threshold_usd     = 10

# Reconfirmar con SHOW GLOBAL VARIABLES LIKE 'max_connections' en la instancia.
# database_max_connections = 120
