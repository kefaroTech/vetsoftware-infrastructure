# Use el mismo bucket remoto de Terraform, pero una key exclusiva para dev.
bucket       = "vetsoftware-prod-tfstate-123456789012"
key          = "vetsoftware/dev/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true

# Incluya kms_key_id si el bootstrap creó una KMS key dedicada.
# kms_key_id = "arn:aws:kms:us-east-1:123456789012:key/REEMPLAZAR"
