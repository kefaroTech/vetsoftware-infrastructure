# Copie este archivo a terraform.tfvars. Nunca guarde secretos aquí.
aws_region  = "us-east-1"
environment = "dev"

# Dev crea su propia VPC. El CIDR no debe solaparse con el de prod (10.40.0.0/16).
vpc_cidr                = "10.50.0.0/16"
availability_zone_count = 2

# En Cloudflare Tunnel publique este host con origen http://localhost:8080.
api_domain_name = "dev-api.kefaro.tech"

# Use digest inmutable y una imagen ARM64 compatible con Fargate Spot.
backend_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/vetsoftware-dev-backend@sha256:REEMPLAZAR_64_HEX"

grafana_otlp_endpoint = "https://otlp-gateway-prod-us-east-0.grafana.net/otlp"
# Fronts dev publicados en Cloudflare Pages sobre la zona kefaro.tech.
cors_allowed_origins   = ["https://dev-public.kefaro.tech", "https://dev-admin.kefaro.tech"]
email_from             = "VetSoftware Dev <noreply@kefaro.tech>"
registration_verification_url = "https://dev-public.kefaro.tech/verify-email"
password_reset_url             = "https://dev-public.kefaro.tech/restablecer-contrasena"
login_url                      = "https://dev-public.kefaro.tech/login"

# Variables ephemeral recomendadas, no tfvars:
# $env:TF_VAR_application_secrets_json = '{"JWT_SECRET":"...mínimo-32...","RESEND_API_KEY":"re_xxx","RECAPTCHA_SECRET":"xxx"}'
# $basic = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("OTLP_USERNAME:OTLP_API_KEY"))
# $env:TF_VAR_grafana_secrets_json = "{`"OTLP_USERNAME`":`"...`",`"OTLP_API_KEY`":`"...`",`"OTEL_EXPORTER_OTLP_HEADERS`":`"Authorization=Basic $basic`"}"
# $env:TF_VAR_cloudflare_tunnel_token = "token-del-tunel-dev"

# Perfil económico predeterminado:
# backend 512 CPU / 2048 MiB, solo Fargate Spot, escalado acotado a 0–1 tarea
# RDS db.t4g.micro / 20 GiB / backup 7 dias / proteccion contra borrado / snapshot final
# Valkey Serverless 1 GB / 1000 ECPU, logs 3 días, sin ALB y sin Alloy dedicado
# Confirme la suscripción SNS enviada a alarm_email. Antes de configurar IDs de Slack,
# autorice el workspace en Amazon Q Developer in chat applications.
alarm_email               = "finops@example.com"
monthly_budget_usd        = 35
cost_anomaly_threshold_usd = 3
slack_workspace_id        = "T0123456789"
slack_channel_id          = "C0123456789"

# Solo apagado, al cierre del horario laboral de Colombia. El encendido es manual,
# con el workflow "Start dev environment". RDS se detiene 15 minutos despues de ECS.
scheduled_shutdown_enabled = true
schedule_timezone          = "America/Bogota"
backend_stop_schedule      = "cron(0 20 ? * MON-FRI *)"
database_stop_schedule     = "cron(15 20 ? * MON-FRI *)"
