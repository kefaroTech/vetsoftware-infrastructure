# Copie este archivo a terraform.tfvars. Nunca guarde secretos aquí.
aws_region  = "us-east-1"
environment = "dev"

# Dev crea su propia VPC. El CIDR no debe solaparse con el de prod (10.40.0.0/16).
vpc_cidr                = "10.50.0.0/16"
availability_zone_count = 2

# En Cloudflare Tunnel publique este host con origen http://localhost:8080.
api_domain_name = "dev-api.kefaro.tech"

# Use digest inmutable y una imagen ARM64 compatible con Fargate Spot.
backend_image_uri = "123456789012.dkr.ecr.us-east-1.amazonaws.com/vetsoftware-dev-backend@sha256:REEMPLAZAR_64_HEX"

grafana_otlp_endpoint = "https://otlp-gateway-prod-us-east-3.grafana.net/otlp"
# Fronts dev publicados en Cloudflare Pages sobre la zona kefaro.tech.
cors_allowed_origins   = ["https://dev-public.kefaro.tech", "https://dev-admin.kefaro.tech"]
email_from             = "VetSoftware Dev <noreply@kefaro.tech>"
registration_verification_url = "https://dev-public.kefaro.tech/verify-email"
password_reset_url             = "https://dev-public.kefaro.tech/restablecer-contrasena"
login_url                      = "https://dev-public.kefaro.tech/login"

# Los cuatro UUID de plantilla de Resend del producto. Las plantillas se crean A MANO en
# el panel de Resend: copie aqui el identificador de cada una, nunca deje el marcador.
# Antes eran default commiteado en el application.yml del backend; ahora cada entorno
# apunta a las suyas sin recompilar la imagen.
registration_verification_template_id = "REEMPLAZAR_UUID_PLANTILLA_RESEND"
password_reset_template_id            = "REEMPLAZAR_UUID_PLANTILLA_RESEND"
employee_invitation_template_id       = "REEMPLAZAR_UUID_PLANTILLA_RESEND"
appointment_confirmation_template_id  = "REEMPLAZAR_UUID_PLANTILLA_RESEND"

# Alta de superadministradores de plataforma: CONSOLA DE PLATAFORMA (dev-admin), no la
# app del tenant de las tres lineas de arriba. Sin las cuatro el backend no arranca;
# ResendPlatformAccessEmailSender las exige al construir el bean con el correo activo.
platform_approver_email         = "software@kefaro.tech"
platform_access_review_base_url = "https://dev-admin.kefaro.tech/aprobar-acceso"
platform_invitation_base_url    = "https://dev-admin.kefaro.tech/aceptar-invitacion"
platform_access_login_url       = "https://dev-admin.kefaro.tech/login"

# Los cuatro UUID de plantilla de Resend. Las plantillas se crean A MANO en el panel de
# Resend: copie aqui el identificador de cada una, nunca deje el marcador. El bean valida
# las OCHO claves de este bloque al construirse, no una a una.
platform_access_request_template_id  = "REEMPLAZAR_UUID_PLANTILLA_RESEND"
platform_access_approved_template_id = "REEMPLAZAR_UUID_PLANTILLA_RESEND"
platform_access_rejected_template_id = "REEMPLAZAR_UUID_PLANTILLA_RESEND"
platform_access_welcome_template_id  = "REEMPLAZAR_UUID_PLANTILLA_RESEND"

# Envio durable de logs a Grafana Cloud por Kinesis Firehose. El endpoint es el del
# stack y ya viene por defecto; solo se declara aqui si cambia de stack.
log_shipping_enabled               = true
backend_log_retention_days         = 14
log_shipping_backup_retention_days = 30
# grafana_logs_firehose_endpoint = "https://aws-logs-prod-042.grafana.net/aws-logs/api/v1/push"

# Variables ephemeral recomendadas, NUNCA tfvars. Un secreto, una variable: el JSON
# que acaba en Secrets Manager lo compone modules/secrets, no usted. Los nombres de
# clave del secreto -JWT_SECRET, RESEND_API_KEY, ...- siguen siendo los mismos: los
# leen por sufijo las definiciones de tarea de ECS.
# $env:TF_VAR_jwt_secret       = "REEMPLAZAR_MINIMO_32_CARACTERES"
# $env:TF_VAR_resend_api_key   = "re_REEMPLAZAR"
# $env:TF_VAR_recaptcha_secret = "REEMPLAZAR_SECRETO_DE_SERVIDOR_RECAPTCHA"
# DIAN_ENC_KEY es AES-256: exactamente 32 bytes codificados en base64.
# $env:TF_VAR_dian_enc_key = "REEMPLAZAR_32_BYTES_EN_BASE64"
#
# Las tres de Grafana Cloud. otel_exporter_otlp_headers NO es un tercer secreto que
# se invente: es el Basic que sale de las otras dos, por eso se compone aqui.
# $env:TF_VAR_otlp_username = "REEMPLAZAR_NUMERIC_INSTANCE_ID"
# $env:TF_VAR_otlp_api_key  = "glc_REEMPLAZAR"
# $basic = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("$env:TF_VAR_otlp_username:$env:TF_VAR_otlp_api_key"))
# $env:TF_VAR_otel_exporter_otlp_headers = "Authorization=Basic $basic"
#
# $env:TF_VAR_cloudflare_tunnel_token = "token-del-tunel-dev"
#
# La clave que lee Kinesis Firehose va en SU PROPIO secreto, no dentro del anterior.
# NO es el token a secas: Grafana la compone como <loki_instance_id>:<token>, y el
# instance ID de Loki de este stack es 1706326. El token es de una Cloud Access Policy
# con el unico scope logs:write. Sin espacios alrededor de los dos puntos.
# Pegar solo el glc_... da un apply verde, un stream creado y cero entregas.
# $env:TF_VAR_grafana_logs_access_key = "1706326:glc_..."

# Perfil económico predeterminado:
# backend 512 CPU / 3072 MiB de tarea, solo Fargate Spot, escalado acotado a 0–1 tarea
# RDS db.t4g.small / 20 GiB / backup 7 dias / proteccion contra borrado / snapshot final
# Valkey Serverless 1 GB / 1000 ECPU, logs 3 días, sin ALB y sin Alloy dedicado
# Confirme la suscripción SNS enviada a alarm_email. Antes de configurar IDs de Slack,
# autorice el workspace en Amazon Q Developer in chat applications.
alarm_email               = "finops@example.com"
monthly_budget_usd        = 35
cost_anomaly_threshold_usd = 3
slack_workspace_id        = "T0123456789"
slack_channel_id          = "C0123456789"

# Solo apagado, al cierre del horario laboral de Colombia. El encendido es manual,
# con el workflow "Start dev environment". RDS se detiene 15 minutos despues de ECS.
scheduled_shutdown_enabled = true
schedule_timezone          = "America/Bogota"
backend_stop_schedule      = "cron(0 20 ? * MON-FRI *)"
database_stop_schedule     = "cron(15 20 ? * MON-FRI *)"

# Sidecar colector de trazas y metricas, con cola en disco y reintento de 30 min.
# Se entrega APAGADO: RemoteConnectionValidator rechaza localhost en los endpoints
# OTLP de trazas y metricas, asi que encenderlo contra la imagen actual del backend
# impide arrancar la aplicacion, no solo degrada la telemetria. Detalle y condicion
# de salida en docs/ALERTAS_OPERATIVAS.md, seccion 6.ter.
# El sidecar reutiliza OTLP_USERNAME y OTLP_API_KEY del secreto de Grafana Cloud:
# se autentica con basicauth, no con la cabecera ya construida.
telemetry_sidecar_enabled = false

# Muestreo al 100 %. El emisor deja de decidir que traza sobrevive; lo decide
# Adaptive Traces en Grafana Cloud, que ve la traza completa. Medido: pico de
# 0,225 spans/s al 25 %, ~0,9 spans/s al 100 %, contra un limite de ~1.250.
tracing_sampling = 1.0

# Bedrock: permiso de invocacion, presupuesto y alarma (fase 2.1).
#
# Los valores de abajo son los de por defecto y se repiten aqui solo para que se
# vean; el entorno funciona sin declararlos.
#
# ATENCION, prerrequisito humano que NO esta en el codigo: conceder
# bedrock:InvokeModel no basta. La cuenta tiene que haber habilitado el acceso al
# modelo, y eso es un formulario en la consola de Bedrock que a 2026-08-29 NO
# esta hecho en dev. Sin ese paso la invocacion falla con AccessDeniedException
# aunque la politica sea perfecta, y el mensaje se parece lo bastante al de un
# permiso ausente como para mandar a cualquiera a depurar la politica
# equivocada. Se comprueba con `aws bedrock get-use-case-for-model-access`: si
# devuelve ResourceNotFoundException, el formulario sigue sin rellenar. Los otros
# tres comandos que uno probaria dan falsos positivos.
bedrock_enabled              = true
bedrock_inference_profile_id = "us.anthropic.claude-sonnet-5"
bedrock_foundation_model_id  = "anthropic.claude-sonnet-5"

# El tope diario que aplica la aplicacion antes de invocar. El presupuesto
# mensual de Bedrock se deriva de este numero -x30, redondeado hacia arriba: USD
# 10-, asi que subir el tope sube el presupuesto en el mismo commit y no hay
# forma de moverlos por separado.
bedrock_daily_spend_cap_usd = 0.33

# Invocaciones en cinco minutos que hacen sonar la alarma. Es el respaldo de ese
# tope, no su sustituto: 20 en cinco minutos son ~USD 0,60, casi el doble del
# gasto diario autorizado entero, asi que si suena es que el tope de la
# aplicacion dejo de cortar.
bedrock_invocation_surge_threshold = 20
