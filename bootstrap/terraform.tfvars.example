project_name = "vetsoftware"
environment  = "prod"
aws_region   = "us-east-1"
enable_kms   = true
github_organization = "kefaroTech"
github_organization_id = "12345678"
github_environment  = "production"
ecr_images_to_keep  = 30
# existing_github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

github_repositories = {
  backend       = "VetSoftware"
  private_front = "VetSoftwareFront"
  public_front  = "VetSoftwarePublicFront"
  iac           = "VetSoftwareIaC"
}

github_repository_ids = {
  backend       = "100000001"
  private_front = "100000002"
  public_front  = "100000003"
  iac           = "100000004"
}

# Cada función usa un GitHub Environment distinto; no reutilice production.
# Si un bucket administrado no sigue vetsoftware-<entorno>-*, agregue aquí su ARN explícito.
github_iac_environments = {
  dev = {
    state_key                = "vetsoftware/dev/terraform.tfstate"
    github_plan_environment  = "iac-plan-dev"
    github_apply_environment = "iac-apply-dev"
  }
  prod = {
    state_key                = "vetsoftware/prod/terraform.tfstate"
    github_plan_environment  = "iac-plan-prod"
    github_apply_environment = "iac-apply-prod"
  }
}

tags = {
  Owner      = "VetSoftware"
  CostCenter = "production"
}
